{
 "cards": {
  "chipper": "<div class=\"card chipper\">\n      <span class=\"new\" style=\"background:#666\">LAB</span>\n      <div class=\"kind\">Sample Mulcher</div>\n      <h2>MULCH</h2>\n      <p class=\"tag\">Feed it any sample. Get a brand new instrument back.</p>\n      <p class=\"desc\">Drag up to 8 samples into the chipper and it births one new playable instrument out of the whole pile. New in v2.0: held notes sustain forever with a real ADSR, plus a RANDOMIZE dice with reproducible seeds, texture smear, freeze and a chaos macro.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/mulch.png\"><source src=\"https://video.sebastianmacan.com/img/video/mulch_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Mulch-v2.0-macOS.pkg\">Download Mulch</a>\n      <a class=\"more\" href=\"mulch.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v2.0 \u00b7 VST3 + AU instrument</div>\n    </div>",
  "wave": "<div class=\"card wave\">\n      <span class=\"new\" style=\"background:#666\">LAB</span>\n      <div class=\"kind\">Future Bass Chord Machine</div>\n      <h2>TSUNAMI</h2>\n      <p class=\"tag\">One key. One wall of supersaw chords.</p>\n      <p class=\"desc\">Five-note chords, seven detuned saws each, clean sub underneath: 35 oscillators per finger. Pick the flavor (Minor 9 anyone?), grab the big CUTOFF knob, let PUMP bounce it. The ocean swells while you play.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/tsunami.png\"><source src=\"https://video.sebastianmacan.com/img/video/tsunami_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Tsunami-v1.0-macOS.pkg\">Download Tsunami</a>\n      <a class=\"more\" href=\"tsunami.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v1.0 \u00b7 VST3 + AU instrument</div>\n    </div>",
  "bloom": "<div class=\"card bloom\">\n      <span class=\"new\" style=\"background:#666\">LAB</span>\n      <div class=\"kind\">Melodic House Texture</div>\n      <h2>BLOOM</h2>\n      <p class=\"tag\">Play a plain chord. Get a festival sunrise.</p>\n      <p class=\"desc\">One BLOOM knob opens shimmer, reverb and motion. BREATHE pumps it in time with your track, WARMTH adds tape glow, WIDTH stays mono-safe. Eight presets from Anjuna Sunrise to Deep Field.</p>\n      <a class=\"dl\" href=\"downloads/Bloom-v1.0-macOS.pkg\">Download Bloom</a>\n      <a class=\"more\" href=\"bloom.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v1.0 \u00b7 VST3 + AU effect</div>\n    </div>",
  "gremlin": "<div class=\"card gremlin\">\n      <span class=\"new\" style=\"background:#666\">LAB</span>\n      <div class=\"kind\">Stutter Glitch Machine</div>\n      <h2>GREMLIN</h2>\n      <p class=\"tag\">Controlled demolition for your drums.</p>\n      <p class=\"desc\">Tempo-synced slicing, 1 to 16 stutter repeats, reverse and octave-jump chaos, all on a reproducible SEED. Auto mode strikes on its own, or smash the GLITCH! pad for manual fills. Twelve presets from Machine Gun to Stairs Down.</p>\n      <a class=\"dl\" href=\"downloads/Gremlin-v1.0-macOS.pkg\">Download Gremlin</a>\n      <a class=\"more\" href=\"gremlin.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v1.0 \u00b7 VST3 + AU effect</div>\n    </div>",
  "ghost": "<div class=\"card ghost\">\n      <div class=\"kind\">Granular Texture Machine</div>\n      <h2>GHOST</h2>\n      <p class=\"tag\">Freeze sound. Then haunt it.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/ghost.png\"><source src=\"https://video.sebastianmacan.com/img/video/ghost_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Ghost-v1.1-macOS.pkg\">Download Ghost</a>\n      <a class=\"more\" href=\"ghost.html\">See how it works &rarr;</a>\n      <div class=\"meta\">VST3 + AU &middot; macOS</div>\n    </div>",
  "mayday": "<div class=\"card mayday\">\n      <div class=\"kind\">Riser Generator</div>\n      <h2>MAYDAY</h2>\n      <p class=\"tag\">Hold a note. Brace for takeoff.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/mayday.png\"><source src=\"https://video.sebastianmacan.com/img/video/mayday_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Mayday-v2.0-macOS.pkg\">Download Mayday</a>\n      <a class=\"more\" href=\"mayday.html\">See how it works &rarr;</a>\n      <div class=\"meta\">VST3 + AU &middot; macOS</div>\n    </div>",
  "fauna": "<div class=\"card fauna\">\n      <div class=\"kind\">Creature Voice Synth</div>\n      <h2>FAUNA</h2>\n      <p class=\"tag\">Play the ocean. Play the sky.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/fauna.png\"><source src=\"https://video.sebastianmacan.com/img/video/fauna_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Fauna-v1.0-macOS.pkg\">Download Fauna</a>\n      <a class=\"more\" href=\"fauna.html\">See how it works &rarr;</a>\n      <div class=\"meta\">VST3 + AU &middot; macOS</div>\n    </div>",
  "rustybot": "<div class=\"card rustybot\">\n      <span class=\"new\" style=\"background:#666\">LAB</span>\n      <div class=\"kind\">Robot Voice Machine</div>\n      <h2>RUSTY</h2>\n      <p class=\"tag\">Eight robots living in one box.</p>\n      <p class=\"desc\">Vocoder chrome, singing talkbox, angry Dalek, 80s toy, talking dubstep sub bass, demon ghost choir, dial-up modem screams and a stutter glitch gremlin. SPARK rolls the slot machine, STACK doubles, triples, choruses, phases and flanges the robot wide.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/rusty.png\"><source src=\"https://video.sebastianmacan.com/img/video/rusty_ui_loop.mp4\" type=\"video/mp4\"></video></div>\n      <a class=\"dl\" href=\"downloads/Rusty-v3.2-macOS.pkg\">Download Rusty &middot; $5</a>\n      <a class=\"more\" href=\"rusty.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v3.2 &middot; VST3 + AU effect</div>\n    </div>",
  "reels": "    <div class=\"card reels\">\n      <span class=\"new\">PARKED</span>\n      <div class=\"kind\">Dirty Tape for Lofi Drums</div>\n      <h2 style=\"background:linear-gradient(135deg,#e8a05c,#f5d7a1);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;\">REELS</h2>\n      <p class=\"tag\">Dirty tape for lofi drums. Make it filthier.</p>\n      <p class=\"desc\">Put your drum bus on a tape machine that has seen things. Head bump, wow &amp; flutter, age, hiss, crackle and hum. Three machines from studio reel to a 30-year-old cassette. Watch the reels actually spin.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/reels.png?v=2.0.1\"><source src=\"https://video.sebastianmacan.com/img/video/reels_ui_loop.mp4?v=2.0.1\" type=\"video/mp4\"></video></div>\n      <span class=\"dl buy\" style=\"background:linear-gradient(135deg,#e8a05c,#f5d7a1);box-shadow:0 6px 28px rgba(232,160,92,.26);\" role=\"button\" tabindex=\"0\" data-cart-buy=\"reels\">Buy Reels &middot; $15</span>\n      <div class=\"cartrow\"><span class=\"cartbtn add\" role=\"button\" tabindex=\"0\" data-cart-add=\"reels\">Add to Cart</span><span class=\"cartbtn buy\" role=\"button\" tabindex=\"0\" data-cart-buy=\"reels\">Buy Now</span></div>\n      <a class=\"more\" href=\"reels.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v2.1.0 \u00b7 VST3 + AU effect \u00b7 macOS + Windows</div>\n    </div>",
  "halo": "    <div class=\"card halo\">\n      <span class=\"new\">PARKED</span>\n      <div class=\"kind\">One-Knob Mastering</div>\n      <h2 style=\"background:linear-gradient(135deg,#ffd47e,#fff3d0);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;\">HALO</h2>\n      <p class=\"tag\">Drop it on your master. Turn LIFT until the halo closes.</p>\n      <p class=\"desc\">Pick Streaming, Club or Podcast, then turn one knob until the golden ring closes. Loud, glued, streaming-ready. Built-in LUFS meter, verified accurate, with a bit-transparent METER ONLY mode.</p>\n      <div class=\"shot\"><video autoplay muted loop playsinline preload=\"metadata\" poster=\"img/ui/halo.png?v=1.2\"><source src=\"https://video.sebastianmacan.com/img/video/halo_ui_loop.mp4?v=1.2\" type=\"video/mp4\"></video></div>\n      <span class=\"dl buy\" style=\"background:linear-gradient(135deg,#fbbf24,#fef3c7);box-shadow:0 6px 28px rgba(251,191,36,.26);\" role=\"button\" tabindex=\"0\" data-cart-buy=\"halo\">Buy Halo &middot; $29</span>\n      <div class=\"cartrow\"><span class=\"cartbtn add\" role=\"button\" tabindex=\"0\" data-cart-add=\"halo\">Add to Cart</span><span class=\"cartbtn buy\" role=\"button\" tabindex=\"0\" data-cart-buy=\"halo\">Buy Now</span></div>\n      <a class=\"more\" href=\"halo.html\">See how it works &rarr;</a>\n      <div class=\"meta\">v1.2 \u00b7 VST3 + AU effect \u00b7 macOS + Windows</div>\n    \n    </div>"
 },
